<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
  <environments default="development">
    <environment id="development">
      <transactionManager type="JDBC"/>
      <dataSource type="POOLED">
        <property name="driver" value="org.postgresql.Driver"/>
        <property name="url" value="jdbc:postgresql://localhost:5432/postgres"/>
        <property name="username" value="anochat"/>
        <property name="password" value="icd_anochat"/>
      </dataSource>
    </environment>
  </environments>
  <mappers>
    <!-- <mapper resource="com/anochat_api/mapper/ChatUpdateMapper.xml"/> -->
    <mapper resource="com/anochat_api/mapper/ChatMapper.xml"/>
    <mapper resource="com/anochat_api/mapper/MessageMapper.xml"/>
  </mappers>
</configuration>