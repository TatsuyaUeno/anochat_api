<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anochat_api.mapper.NewChatMapper">
	<select id="createNewChat" parameterType="com.anochat_api.dto.ChatDto">
		INSERT INTO trn_chat_message
		VALUES (
            #{chatName},
        )
	</select>
	<select id="countChats" resultType="int">
		SELECT COUNT(*) FROM trn_chat_message
	</select>
</mapper>